cp -f /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/k1-x_fpga.dtb /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs/ 
cp -f /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/rootfs.cpio.gz /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs/initramfs-generic.img
mcopy -i /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs.img /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs/* ::
