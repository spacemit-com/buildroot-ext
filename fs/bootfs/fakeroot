#!/bin/sh
set -e
rm -rf /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs
mkdir -p /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs
rm -f /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs.img
dd if=/dev/zero of=/media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs.img count=1 bs=292M
mkfs.vfat /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs.img
cp -f /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/env.bin /media/max/max-ssd/workspace/bianbu-linux/output/k1-x_fpga/images/bootfs/ 
