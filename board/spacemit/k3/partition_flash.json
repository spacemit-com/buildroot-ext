{
  "version": "1.0",
  "format": "gpt",
  "partitions": [
    {
      "name": "env",
      "comment": "uboot env data partition, MUST not change its offset and size",
      "hidden": true,
      "offset": "640K",
      "size": "64K",
      "image": "env.bin"
    },
    {
      "name": "bootinfo",
      "comment": "contain address and size info of fsbl, MUST not change its position",
      "hidden": true,
      "offset": "1M",
      "size": "128K",
      "image": "factory/bootinfo_block.bin"
    },
    {
      "name": "fsbl",
      "comment": "its offset was designated by bootinfo",
      "hidden": true,
      "offset": "1536K",
      "size": "512K",
      "image": "factory/FSBL.bin"
    },
    {
      "name": "bootfs",
      "type": "FAT32",
      "offset": "4M",
      "size": "-",
      "image": ["factory/bootinfo_block.bin",
                "factory/bootinfo_spinand.bin",
                "factory/bootinfo_spinor.bin",
                "factory/FSBL.bin",
                "opensbi.itb",
                "u-boot.itb",
                "esos.itb",
                "bootloader.img",
                "bootfs.img",
                "/partition_.+.json$/"]
    }
  ]
}
