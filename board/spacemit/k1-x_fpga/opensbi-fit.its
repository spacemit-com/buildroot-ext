/dts-v1/;

/ {
	description = "sbi FIT image for k1x";
	#address-cells = <2>;

	images {
		firmware {
			description = "opensbi";
			data = /incbin/("./fw_dynamic.bin");
			type = "firmware";
			arch = "riscv";
			os = "opensbi";
			load = <0x0 0x46000000>;
			compression = "none";
		};
		
	};

	configurations {
		default = "config";
		config {
			description = "sbi FIT config for k1x";
			firmware = "firmware";
		};
	};
};

