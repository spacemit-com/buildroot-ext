/dts-v1/;

/ {
	description = "U-boot FIT image for k1x";
	#address-cells = <2>;

	images {
		firmware {
			description = "u-boot";
			data = /incbin/("./fw_payload.bin");
			type = "firmware";
			arch = "riscv";
			os = "u-boot";
			load = <0x0 0x00100000>;
			entry = <0x0 0x00100000>;
			compression = "none";
		};
	};

	configurations {
		default = "config-1";
		config-1 {
			description = "U-boot FIT config for k1x";
			firmware = "firmware";
		};
	};
};

