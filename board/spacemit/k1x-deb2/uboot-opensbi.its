/dts-v1/;

/ {
	description = "U-boot FIT image for k1x";
	#address-cells = <2>;
	fit,fdt-list = "of-list";

	images {
		uboot {
			description = "U-Boot";
			type = "standalone";
			os = "U-Boot";
			arch = "riscv";
			compression = "none";
			load = <0x0 0x00200000>;
			data = /incbin/("./u-boot-nodtb.bin");
		};

		opensbi {
			description = "OpenSBI fw_dynamic Firmware";
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			load = <0x0 0x0>;
			entry = <0x0 0x0>;
			data = /incbin/("./fw_dynamic.bin");
		};

		fdt_1 {
			description = "Flattened Device Tree blob";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("./u-boot.dtb");
		};

	};

	configurations {
		default = "config-1";
		config-1 {
			description = "U-boot FIT config for k1x";
			firmware = "opensbi";
			loadables = "uboot";
			fdt = "fdt_1";
		};
	};
};

