/*
 * Simple U-Boot uImage source file containing a single kernel and FDT blob
 */

/dts-v1/;

/ {
	description = "Simple image with single Linux kernel and FDT blob";
	#address-cells = <2>;

	images {
		kernel {
			description = "Vanilla Linux kernel";
			data = /incbin/("./Image");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "none";
			load = <0x0 0x21000000>;
			entry = <0x0 0x21000000>;
		};
		fdt-1 {
			description = "Flattened Device Tree blob";
			data = /incbin/("./k1-x_fpga.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x0 0x28000000>;
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Boot Linux kernel with FDT blob";
			kernel = "kernel";
			fdt = "fdt-1";
		};
	};
};
