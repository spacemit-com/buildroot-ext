/dts-v1/;

/ {
	description = "U-boot FIT image for k1x";
	#address-cells = <2>;

	images {
		firmware {
			description = "u-boot";
			data = /incbin/("./u-boot-nodtb.bin");
			type = "firmware";
			arch = "riscv";
			os = "u-boot";
			load = <0x0 0x00100000>;
			entry = <0x0 0x00100000>;
			compression = "none";
		};
		fdt {
			description = "u-boot dtb";
			data = /incbin/("./u-boot.dtb");
			type = "flat_dt";
			arch = "riscv";
			load = <0x0 0x46100000>;
			compression = "none";
		};

		fdt1 {
			description = "u-boot dtb";
			data = /incbin/("./u-boot.dtb");
			type = "flat_dt";
			arch = "riscv";
			load = <0x0 0x46100000>;
			compression = "none";
		};
	};

	configurations {
		default = "deconfig";
		deconfig {
			description = "U-boot FIT config for k1x";
			firmware = "firmware";
			fdt = "fdt";
		};
		config-1 {
			description = "U-boot FIT config for k1x";
			firmware = "firmware";
			fdt = "fdt1";
		};
	};
};

