 leaks inc file

---
 office/ghostscript/src/arch.h             |  35 ++
 office/ghostscript/src/echogs             | Bin 0 -> 1047984 bytes
 office/ghostscript/src/genarch            | Bin 0 -> 871872 bytes
 office/ghostscript/src/genconf            | Bin 0 -> 903112 bytes
 office/ispell/Makefile                    |  20 +-
 office/ispell/languages/american/Makefile |   2 +-
 office/rsynth/Makefile                    | 129 ++++++
 office/rsynth/config.h                    |  91 +++++
 office/rsynth/hplay.c                     | 145 +++++++
 office/sphinx/include/s2params.h          |  12 +-
 office/sphinx/src/examples/Makefile       | 473 ++++++++++++++++++++++
 11 files changed, 890 insertions(+), 17 deletions(-)
 create mode 100644 office/ghostscript/src/arch.h
 create mode 100755 office/ghostscript/src/echogs
 create mode 100755 office/ghostscript/src/genarch
 create mode 100755 office/ghostscript/src/genconf
 create mode 100755 office/rsynth/Makefile
 create mode 100755 office/rsynth/config.h
 create mode 100755 office/rsynth/hplay.c
 create mode 100755 office/sphinx/src/examples/Makefile

diff --git a/office/ghostscript/src/arch.h b/office/ghostscript/src/arch.h
new file mode 100644
index 0000000..78dd14a
--- /dev/null
+++ b/office/ghostscript/src/arch.h
@@ -0,0 +1,35 @@
+/* Parameters derived from machine and compiler architecture */
+
+	/* ---------------- Scalar alignments ---------------- */
+
+#define arch_align_short_mod 2
+#define arch_align_int_mod 4
+#define arch_align_long_mod 8
+#define arch_align_ptr_mod 8
+#define arch_align_float_mod 4
+#define arch_align_double_mod 8
+
+	/* ---------------- Scalar sizes ---------------- */
+
+#define arch_log2_sizeof_short 1
+#define arch_log2_sizeof_int 2
+#define arch_log2_sizeof_long 3
+#define arch_sizeof_ds_ptr 8
+#define arch_sizeof_ptr 8
+#define arch_sizeof_float 4
+#define arch_sizeof_double 8
+
+	/* ---------------- Unsigned max values ---------------- */
+
+#define arch_max_uchar ((unsigned char)0xff + (unsigned char)0)
+#define arch_max_ushort ((unsigned short)0xffff + (unsigned short)0)
+#define arch_max_uint ((unsigned int)0xffffffff + (unsigned int)0)
+#define arch_max_ulong ((unsigned long)0xffffffffffffffffL + (unsigned long)0)
+
+	/* ---------------- Miscellaneous ---------------- */
+
+#define arch_is_big_endian 0
+#define arch_ptrs_are_signed 0
+#define arch_floats_are_IEEE 1
+#define arch_arith_rshift 2
+#define arch_can_shift_full_long 0
