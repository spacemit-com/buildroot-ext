Date: Thu, 23 Mar 2023 14:40:06 +0800
Subject: [PATCH] adjust-makefile-to-fix-compile-err

---
 makefile                  |  11 +-
 oav2/makefile             |  17 +--
 util/make/armcc.mak       | 224 -------------------------------------
 util/make/bak/arm-elf.mak | 195 --------------------------------
 util/make/bak/gccarm.mak  | 196 --------------------------------
 util/make/bak/gccppc.mak  | 191 -------------------------------
 util/make/bak/vc.mak      | 182 ------------------------------
 util/make/gcc.mak         |  18 +--
 util/make/ghs.mak         | 229 --------------------------------------
 util/make/vcvars32.bat    |  23 ----
 util/makefile             |  11 +-
 util/psnr/Makefile        |   2 +-
 12 files changed, 35 insertions(+), 1264 deletions(-)
 delete mode 100644 util/make/armcc.mak
 delete mode 100644 util/make/bak/arm-elf.mak
 delete mode 100644 util/make/bak/gccarm.mak
 delete mode 100644 util/make/bak/gccppc.mak
 delete mode 100644 util/make/bak/vc.mak
