BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="http://lnode1.dc.com:20000/software/toolchain/spacemit-gcc-linux-glibc-x86_64-jdsk-v0.1.5-20230324T022642.tar.gz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-unknown-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_PACKAGE_OVERRIDE_FILE="$(TOPDIR)/../buildroot-ext/local.mk"
BR2_GLOBAL_PATCH_DIR="$(TOPDIR)/../buildroot-ext/patches/"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_Bianbu_PATH)/board/spacemit/k1-x_fpga/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_Bianbu_PATH)/board/spacemit/k1-x_fpga/overlay_rootfs_img.sh support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_Bianbu_PATH)/board/spacemit/k1-x_fpga/genimage.cfg"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(LINUX_OVERRIDE_SRCDIR)/arch/riscv/configs/k1-x_fpga_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="spacemit/k1-x_fpga"
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_PCRE=y
BR2_PACKAGE_PCRE_UCP=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_DRACUT=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="300M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_PLAT="generic"
# BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG is not set
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="PLATFORM_DEFCONFIG=k1-x_fpga_defconfig"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_USE_CUSTOM_CONFIG=y
BR2_TARGET_UBOOT_CUSTOM_CONFIG_FILE="$(UBOOT_OVERRIDE_SRCDIR)/configs/k1-x_fpga_defconfig"
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_DTB=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-nodtb.bin"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/u-boot-spl.bin spl/u-boot-spl.dtb spl/u-boot-spl-nodtb.bin"
BR2_PACKAGE_HOST_CMAKE=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_TARGET_BOOTFS=y
BR2_PACKAGE_UBOOT_ENV_CUSTOM=y
BR2_PACKAGE_UBOOT_ENV_CUSTOM_FILE="$(BR2_EXTERNAL_Bianbu_PATH)/board/spacemit/k1-x_fpga/env.txt"
BR2_PACKAGE_LINPACK=y
BR2_PACKAGE_STREAM=y
BR2_PACKAGE_CSMITH=y
BR2_PACKAGE_POSTMARK=y
BR2_PACKAGE_FHOURSTONES88=y
BR2_PACKAGE_BLOGBENCH=y
BR2_PACKAGE_TACHYON=y
BR2_PACKAGE_SWETEST=y
BR2_PACKAGE_SCIMARK2=y
BR2_PACKAGE_MAFFT=y
BR2_PACKAGE_CLOMP=y
BR2_PACKAGE_LZBENCH=y
BR2_PACKAGE_CRAY=y
BR2_PACKAGE_HIMENO=y
BR2_PACKAGE_SMALLPT=y
BR2_PACKAGE_FSMARK=y
BR2_PACKAGE_TIOBENCH=y
BR2_PACKAGE_DCRAW=y
BR2_PACKAGE_AOBENCH=y
BR2_PACKAGE_M_QUEENS=y
BR2_PACKAGE_TSCP=y
BR2_PACKAGE_STOCKFISH=y
BR2_PACKAGE_NBENCH=y
BR2_PACKAGE_AOM_AV1_PSY=y
BR2_PACKAGE_PRIMESIEVE=y
BR2_PACKAGE_TELEBENCH=y
BR2_PACKAGE_OABENCHV2=y
BR2_PACKAGE_XSBENCH=y
BR2_PACKAGE_NCNN=y
